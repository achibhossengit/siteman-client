# Browser-facing API base (empty = same origin + Vite proxy)
# On Netlify/production, set this to your live API URL (e.g. https://api.example.com)
VITE_API_BASE_URL=

# Dev proxy target for /api (vite.config.js) — local only, not needed on Netlify
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Show billing category UI (hajira, cash, site detail, history). Unset/false = hidden.
# VITE_SHOW_BILLING=true
